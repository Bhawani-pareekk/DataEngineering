   "source": [
    "# b2 Answer\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "X = np.array([[2, 10], [4, 20], [6, 30]])\n",
    "\n",
    "# Vectorized min-max normalization along columns (axis=0)\n",
    "X_min = X.min(axis=0)\n",
    "X_max = X.max(axis=0)\n",
    "\n",
    "X_norm = (X - X_min) / (X_max - X_min)\n",
    "\n",
    "print(X_norm)"
   ]
  }
 ],
